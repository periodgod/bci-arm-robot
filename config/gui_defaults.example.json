{
  "collection": {
    "paradigm_key": "eeg8",
    "mode": "BrainVision LSL（EEG+肌电）",
    "out_path": "data/recordings",
    "fs": 250,
    "trials_per_class": 12,
    "epoch_seconds": 5.0,
    "pre_rest_seconds": 8.0,
    "cue_seconds": 1.0,
    "cue_rest_seconds": 3.0,
    "post_rest_seconds": 3.0,
    "host": "auto",
    "port": 51244,
    "expected_channels": 32,
    "aux_channels": 4,
    "use_parallel_trigger": true,
    "parallel_port": 888
  },
  "paths": {
    "train_data_path": "",
    "test_data_path": "",
    "model_path": "models/arm_bci_gui.joblib",
    "vr_model_path": "models/arm_bci_gui.joblib"
  },
  "model": {
    "validation_strategy": "grouped",
    "feature_strategy": "fbcsp",
    "classifier": "vote",
    "use_csp": true
  },
  "realtime": {
    "model_path": "models/arm_bci_gui.joblib",
    "mode": "BrainVision LSL（32导EEG+AUX）",
    "runtime_strategy": "eeg8_two_phase_masseter",
    "use_current_model": true,
    "use_config_thresholds": true,
    "host": "auto",
    "port": 51244,
    "expected_channels": 32,
    "aux_channels": 4,
    "target": "target_1",
    "robot_enabled": false,
    "robot_host": "192.168.1.100",
    "robot_port": 9527,
    "robot_speed": 50.0,
    "decode_window_seconds": 2.0,
    "decode_step_seconds": 2.0,
    "confirm_window_seconds": 1.0,
    "confirmation_masseter_count": 1,
    "continuous_blink_window_seconds": 2.0,
    "continuous_blink_count": 3,
    "aux_blink_ratio": 4.0,
    "aux_bite_ratio": 3.0,
    "aux_side_ratio": 1.35,
    "aux_blink_count": 3,
    "aux_left_count": 1,
    "aux_right_count": 1,
    "decoder": {
      "eeg_weight": 0.55,
      "aux_weight_cap": 0.45,
      "command_confidence": 0.0,
      "min_margin": 0.0,
      "stable_windows": 1,
      "history_windows": 1,
      "refractory_seconds": 0.25,
      "command_duration_seconds": 0.55,
      "artifact_z_threshold": 9.0,
      "masseter_gate_enabled": true,
      "masseter_left_count": 1,
      "masseter_right_count": 1,
      "masseter_bite_ratio": 3.0,
      "masseter_side_ratio": 1.35,
      "masseter_detector": "precise",
      "masseter_state_detectors": {
        "00": "threshold",
        "01": "ncc",
        "10": "ncc",
        "11": "ncc"
      },
      "masseter_template_path": "models/masseter_ncc_templates.json",
      "masseter_ncc_min_score": 0.45,
      "masseter_ncc_min_margin": 0.08,
      "confirmation_window_seconds": 1.0,
      "confirmation_masseter_count": 1,
      "masseter_outside_candidate_weight": 0.3,
      "candidate_random_margin": 0.05,
      "continuous_move_speed": 0.5,
      "continuous_blink_window_seconds": 2.0,
      "continuous_blink_count": 3
    }
  }
}
